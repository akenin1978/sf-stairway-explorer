# Copy this file to .env and fill in your real values.
# .env is gitignored -- never commit real keys.

# Supabase: Project Settings > API Keys > Legacy API Keys tab (or API Keys tab)
# Use the "anon" / "publishable" key here -- NOT the service_role/secret key.
# The anon key is safe to expose in client-side code; the service_role key is not.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Cloud Console > APIs & Services > Credentials
# Same key you used in FlutterFlow works here too, as long as
# "Maps JavaScript API" is enabled for it.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
